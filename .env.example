# --- Database (required) -------------------------------------------------
# Neon free tier: https://neon.tech -> copy the POOLED connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Session signing (required) ------------------------------------------
# Any long random string. Generate one with:  openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# --- AI provider (optional, but needed for open conversation) ------------
# Free Gemini key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Alternative provider (OpenAI-compatible). Set AI_PROVIDER=deepseek to use it.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
